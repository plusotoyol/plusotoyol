# Backend ortam değişkenleri. Gerçek değerleri .env dosyasına yazın (Git'e eklenmez).

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Frontend'in adresi (CORS için)
CORS_ORIGIN=http://localhost:3000

# Veri tabanı: karar verilene kadar kullanılmaz (docs/architecture/decisions.md, K-04)
# DATABASE_URL=

# OSRM: karar verilene kadar kullanılmaz (docs/architecture/decisions.md, K-08)
# OSRM_BASE_URL=
